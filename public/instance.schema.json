{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wilhel1812.github.io/meshtastic-node-configurator/instance.schema.json",
  "title": "Meshtastic Node Configurator instance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "helpers", "defaultFormat", "formats", "defaults", "roleDefaults", "defaultPreset", "presets", "channelBundles", "mqttProviders", "regions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "identity": { "type": "object", "required": ["name", "intro"] },
    "helpers": { "type": "object", "required": ["norway"] },
    "namingConventionUrl": { "type": "string", "format": "uri" },
    "defaultFormat": { "enum": ["2.8", "2.7.26"] },
    "formats": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "label", "protobufVersion"] } },
    "defaults": { "type": "object" },
    "roleDefaults": { "type": "object" },
    "defaultPreset": { "type": "string", "minLength": 1 },
    "presets": { "type": "array", "minItems": 1 },
    "channelBundles": { "type": "array" },
    "mqttProviders": { "type": "array" },
    "regions": { "type": "array" }
  }
}
